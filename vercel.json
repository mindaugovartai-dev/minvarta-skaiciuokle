{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "tvoralentes.minvarta.lt" }],
      "dest": "/tvoralentes.html"
    },
    {
      "src": "^/tvoralentes/?$",
      "dest": "/tvoralentes.html"
    },
    { "handle": "filesystem" }
  ]
}
